# ============================================
# AI Math Solver — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git!
# ============================================

# OpenRouter API Key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Configuration (override defaults if needed)
# SOLVER_MODEL=deepseek/deepseek-r1:free
# CLASSIFIER_MODEL=deepseek/deepseek-chat-v3-0324:free
# VISION_MODEL=deepseek/deepseek-r1:free

# Logging
# LOG_LEVEL=INFO
